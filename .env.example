# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=["*"]

# Storage Configuration ("file_storage", "firebase", or "ms_graph")
STORAGE_BACKEND=file_storage
DATA_DIR=data

# Firebase / Firestore & Cloud Storage Configuration (when STORAGE_BACKEND=firebase)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIRESTORE_DATABASE=

# Scheduler & Sampling Configuration
TIME_TO_COMPLETE_MINUTES=5
SCHEDULER_TIMEZONE=America/New_York
